{
    "name": "rcalicdan/doc-contract",
    "description": "Runtime enforcement of PHPDoc @param/@return contracts, dev-only, zero-cost in production.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "phpstan/phpdoc-parser": "^2.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.10",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "TypePHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TypePHP\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures/Functions/MathUtils.php"
        ]
    },
    "scripts": {
        "format": ["./vendor/bin/pint"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}