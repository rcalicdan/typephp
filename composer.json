{
    "name": "rcalicdan/doc-contract",
    "description": "Runtime enforcement of PHPDoc @param/@return contracts, dev-only, zero-cost in production.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "phpstan/phpdoc-parser": "^2.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "TypePHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TypePHP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": ["./vendor/bin/pint"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
