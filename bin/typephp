#!/usr/bin/env php
<?php

$autoloadFiles = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php'
];

foreach ($autoloadFiles as $file) {
    if (file_exists($file)) {
        require $file;
        break;
    }
}

// Clean Exception Handler for CLI: filters out TypePHP internal frames
set_exception_handler(function (\Throwable $e) {
    $cleanTrace = array_filter($e->getTrace(), function ($frame) {
        return !str_starts_with($frame['class'] ?? '', 'TypePHP\\');
    });

    fwrite(STDERR, sprintf(
        "Fatal error: Uncaught %s: %s in %s:%d\nStack trace:\n",
        get_class($e),
        $e->getMessage(),
        $e->getFile(),
        $e->getLine()
    ));

    $i = 0;
    foreach ($cleanTrace as $frame) {
        $file = $frame['file'] ?? '[internal function]';
        $line = isset($frame['line']) ? "({$frame['line']})" : '';
        $class = $frame['class'] ?? '';
        $type = $frame['type'] ?? '';
        $func = $frame['function'] ?? '';
        
        fwrite(STDERR, sprintf("#%d %s%s: %s%s%s()\n", $i++, $file, $line, $class, $type, $func));
    }
    
    fwrite(STDERR, sprintf("  thrown in %s on line %d\n\n", $e->getFile(), $e->getLine()));
    exit(255);
});

$args = array_slice($argv, 1);

if (in_array('--clear-cache', $args, true)) {
    $count = \TypePHP\Internal\CacheManager::clear();
    fwrite(STDOUT, sprintf("Cleared %d cached file(s).\n", $count));
    exit(0);
}

$target = null;
foreach ($args as $arg) {
    if (!str_starts_with($arg, '--') && file_exists($arg)) {
        $target = $arg;
        break;
    }
}

if (!$target) {
    die("Usage: vendor/bin/typephp <script.php> [--clear-cache] [--no-cache]\n");
}

\TypePHP\TypePHP::boot();

require realpath($target);